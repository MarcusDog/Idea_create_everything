# Docker Environment Configuration
APP_NAME=Idea Create Everything
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# PostgreSQL Database (for Docker)
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/idea_create
DATABASE_HOST=postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=dev-secret-key-change-in-production-$(openssl rand -hex 32)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API
API_PREFIX=/api
API_V1_PREFIX=/api/v1

# AI (optional - configure in frontend settings page)
CLAUDE_API_KEY=
BRAVE_API_KEY=
DEFAULT_AI_MODEL=claude-3-5-sonnet-20241022
AI_API_TIMEOUT=60
AI_MAX_RETRIES=3

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000

# Backup
AUTO_BACKUP_INTERVAL_HOURS=1
BACKUP_RETENTION_HOURS=24

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
